# Copy to .env. Never commit .env. Values below are placeholders only.
# Settings for later build steps (database, auth, SMTP, model) are added in those steps.
APP_ENV=development            # development | test | production
FACTORY_NAME=Example Factory
FACTORY_TIMEZONE=Asia/Karachi  # IANA timezone name
DATA_DIR=./data                # use /data in Docker
# DATABASE_URL=                # default: sqlite under DATA_DIR (used from step 02)
APP_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM   # production: >=32 random chars
SESSION_COOKIE_SECURE=false    # must be true in production (HTTPS)
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
EXPOSE_API_DOCS=false          # Swagger at /api/docs; never in production
